# Nook — 환경변수 템플릿
# 이 파일을 복사해 .env.local을 만들고 실제 값을 채우세요. (.env.local은 git에 커밋되지 않음)
#   cp .env.example .env.local
# 실제 값 확인: Supabase 대시보드 → Settings → API

# Supabase 프로젝트 URL
# 사용처: middleware.ts, lib/supabase/client.ts, lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon 공개 키 (Publishable / anon key)
# 사용처: middleware.ts, lib/supabase/client.ts, lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase 서비스 롤 키 (Secret / service_role key) — 서버 전용!
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 (브라우저 노출 시 RLS 전체 우회 가능)
# 사용처: app/api/profile/introduction/route.ts (자기소개 조회/저장),
#         app/api/profile/image/route.ts (프로필 이미지 업로드/조회)
# 실제 값 확인: Supabase 대시보드 → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 프로필 이미지 공개 URL 앞부분 — 스토리지 주소부터 버킷명(profile-image)까지, 끝 슬래시 없이
# 전체 이미지 URL = 이 값 + "/" + profile.image_path (버킷명 이후 경로)
# 사용처: lib/profile-image.ts (마이 페이지 프로필 이미지 표시)
NEXT_PUBLIC_PROFILE_IMAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/profile-image
